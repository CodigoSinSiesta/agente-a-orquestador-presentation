---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'De Agente a Orquestador — Codigo Sin Siesta' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="De agente a orquestador, encauzando hacia el desarrollo 100% agéntico. Agente, tool, contexto, sub-agente, orquestador, harness y SDD — y por qué ese andamiaje es temporal."
    />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
